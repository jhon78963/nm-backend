# =============================================================================
# .env.docker — Overrides para docker-compose.full.yml
# Las URLs usan nombres de servicio Docker (red interna nm_network).
# Se carga DESPUÉS de .env y sobrescribe DATABASE_URL y URLs de microservicios.
#
# URLs públicas (tienda, admin, CORS) siguen viniendo de .env raíz:
#   FRONTEND_URL, ECOMMERCE_STORE_URL, CORS_ORIGINS
# =============================================================================

# Zona horaria de contenedores Docker (Perú, UTC-5)
TZ=America/Lima

# ── Base de datos ─────────────────────────────────────────────────────────────
# DATABASE_URL se define en docker-compose.full.yml (usa POSTGRES_* del .env).
REDIS_URL=redis://redis:6379

# ── Microservicios NestJS (red interna) ───────────────────────────────────────
GATEWAY_PORT=3000
AUTH_SERVICE_URL=http://auth-service:3001
CATALOG_SERVICE_URL=http://catalog-service:3002
INVENTORY_SERVICE_URL=http://inventory-service:3003
POS_SERVICE_URL=http://pos-service:3004
FINANCE_SERVICE_URL=http://finance-service:3005
HR_SERVICE_URL=http://hr-service:3006
REPORT_SERVICE_URL=http://report-service:3007
DOCUMENT_SERVICE_URL=http://document-service:3011
STORAGE_SERVICE_URL=http://storage-service:3008
ECOMMERCE_SERVICE_URL=http://ecommerce-service:3012
MAIL_SERVICE_URL=http://mail-service:3013

# ── Claves service-to-service (deben coincidir con .env) ─────────────────────
STORAGE_SERVICE_KEY=nm-storage-dev-key-change-in-production
DOCUMENT_SERVICE_KEY=nm-document-dev-key-change-in-production
MAIL_SERVICE_KEY=nm-mail-dev-key-change-in-production
INTERNAL_SERVICE_KEY=nm-internal-dev-key

# ── Servicios polyglot ────────────────────────────────────────────────────────
AI_ENGINE_URL=http://ai-engine:8000
AI_ENGINE_API_KEY=nm-ai-dev-key-change-in-production
INVOICING_SERVICE_URL=http://invoicing-service:8000
INVOICING_API_KEY=nm-invoicing-dev-key-change-in-production

# ── Chatbot ───────────────────────────────────────────────────────────────────
CHATBOT_SERVICE_URL=http://chatbot-service:3000
CHATBOT_PORT=8090

# ── Ecommerce ─────────────────────────────────────────────────────────────────
ECOMMERCE_TENANT_ID=b14b2a6d-ff01-57e4-9004-7ece99dc46d9
