APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

TELESCOPE_ENABLED=true
# Comma-separated Identity user emails allowed to open /telescope when APP_ENV is not local.
TELESCOPE_ALLOWED_EMAILS=

AUDITING_ENABLED=true
# Record Owen-It audits during Artisan (db:seed, tests). Prefer false outside phpunit.xml.
AUDITING_CONSOLE=false

MEDIA_DISK=s3

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=laravel
DB_USERNAME=sail
DB_PASSWORD=password

# DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

FORWARD_DB_PORT=5433
FORWARD_REDIS_PORT=6379

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Filesystem default; use MinIO-backed S3 in Sail (bucket must exist — create via MinIO Console or mc).
FILESYSTEM_DISK=s3

# MinIO (compose service). MINIO_* must match credentials used for the Laravel s3 disk.
FORWARD_MINIO_PORT=9000
FORWARD_MINIO_CONSOLE_PORT=8900
MINIO_ROOT_USER=sail
MINIO_ROOT_PASSWORD=password

AWS_ACCESS_KEY_ID="${MINIO_ROOT_USER}"
AWS_SECRET_ACCESS_KEY="${MINIO_ROOT_PASSWORD}"
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=local

# Laravel → MinIO API (containers). Override on the host machine to http://127.0.0.1:${FORWARD_MINIO_PORT}.
AWS_ENDPOINT=http://minio:9000

# Optional public/object URL prefix (browser); often unused for private APIs.
AWS_URL=http://127.0.0.1:${FORWARD_MINIO_PORT}

# Required for MinIO and other S3-compatible endpoints.
AWS_USE_PATH_STYLE_ENDPOINT=true

VITE_APP_NAME="${APP_NAME}"
