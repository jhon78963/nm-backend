# =============================================================================
# .env.example — nm-backend-v3
# Copia a .env y ajusta antes de correr servicios o Docker.
#
# Dominios producción:
#   Tienda:   https://novedadesmaritex.net.pe
#   Admin:    https://app.novedadesmaritex.net.pe
#   API:      https://api.novedadesmaritex.net.pe
#   Storage:  https://api.novedadesmaritex.net.pe/api/v1/storage/files
#   Chatbot:  https://chatbot.novedadesmaritex.net.pe
# =============================================================================

# ── Entorno ──────────────────────────────────────────────────────────────────
NODE_ENV=development

# Panel admin (nm-frontend-v2)
FRONTEND_URL=http://localhost:4200
# Producción: https://app.novedadesmaritex.net.pe
ERP_PANEL_URL=http://localhost:4200

# Storefront (nm-ecommerce)
ECOMMERCE_STORE_URL=http://localhost:3015
# Producción: https://novedadesmaritex.net.pe

# CORS del gateway (opcional; si vacío usa FRONTEND_URL + ECOMMERCE_STORE_URL)
CORS_ORIGINS=http://localhost:4200,http://localhost:3015
# Producción:
# CORS_ORIGINS=https://app.novedadesmaritex.net.pe,https://novedadesmaritex.net.pe,https://www.novedadesmaritex.net.pe

# ── Base de datos ─────────────────────────────────────────────────────────────
POSTGRES_DB=nm_services
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_PORT=5433
DATABASE_URL=postgresql://postgres:password@localhost:5433/nm_services

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

EVENT_BUS_ENABLED=true

QUEUE_ENABLED=true
QUEUE_CONCURRENCY=5
QUEUE_ATTEMPTS=3
QUEUE_BACKOFF_MS=5000
QUEUE_REMOVE_ON_COMPLETE=200
QUEUE_REMOVE_ON_FAIL=500

# ── JWT (generar secrets únicos en producción) ────────────────────────────────
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CAMBIA_ESTO_POR_UN_SECRET_DE_64_CHARS_MINIMO
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=CAMBIA_ESTE_TAMBIEN_POR_UN_SECRET_DIFERENTE_64_CHARS
JWT_REFRESH_EXPIRES_IN=7d

# ── Rate limiting ─────────────────────────────────────────────────────────────
THROTTLE_TTL=60000
THROTTLE_LIMIT=120

# ── Microservicios (host local; Docker usa .env.docker) ───────────────────────
GATEWAY_PORT=3000
AUTH_SERVICE_URL=http://localhost:3001
CATALOG_SERVICE_URL=http://localhost:3002
INVENTORY_SERVICE_URL=http://localhost:3003
POS_SERVICE_URL=http://localhost:3004
FINANCE_SERVICE_URL=http://localhost:3005
HR_SERVICE_URL=http://localhost:3006
REPORT_SERVICE_URL=http://localhost:3007
DOCUMENT_SERVICE_URL=http://localhost:3011
STORAGE_SERVICE_URL=http://localhost:3008
ECOMMERCE_SERVICE_URL=http://localhost:3012
MAIL_SERVICE_URL=http://localhost:3013
CHATBOT_SERVICE_URL=http://localhost:8090
HEADER_CACHE_TTL_SECONDS=300

# ── Ecommerce ─────────────────────────────────────────────────────────────────
ECOMMERCE_TENANT_ID=b14b2a6d-ff01-57e4-9004-7ece99dc46d9
ECOMMERCE_SYSTEM_USER_ID=
INTERNAL_SERVICE_KEY=nm-internal-dev-key-change-in-production

# ── Storage ───────────────────────────────────────────────────────────────────
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./storage/uploads
STORAGE_PUBLIC_BASE_URL=http://localhost:3000/api/v1/storage/files
# Producción: https://api.novedadesmaritex.net.pe/api/v1/storage/files
STORAGE_SERVICE_KEY=nm-storage-dev-key-change-in-production
DOCUMENT_SERVICE_KEY=nm-document-dev-key-change-in-production

# ── Mail (Zoho SMTP) ──────────────────────────────────────────────────────────
MAIL_SERVICE_KEY=nm-mail-dev-key-change-in-production
MAIL_SERVICE_ENABLED=true
MAIL_FROM_NAME=Novedades Maritex
MAIL_FROM_EMAIL=no-reply@novedadesmaritex.net.pe
ZOHO_USER=no-reply@novedadesmaritex.net.pe
ZOHO_APP_PASSWORD=
ZOHO_SMTP_HOST=smtp.zoho.com
ZOHO_SMTP_PORT=465
MAIL_LOGO_URL=
MAIL_BANNER_URL=
MAIL_SUPPORT_EMAIL=soporte@novedadesmaritex.net.pe
MAIL_SOCIAL_FACEBOOK=
MAIL_SOCIAL_INSTAGRAM=
MAIL_SOCIAL_TIKTOK=
MAIL_QUEUE_ENABLED=true
MAIL_QUEUE_CONCURRENCY=5
MAIL_QUEUE_ATTEMPTS=3
MAIL_QUEUE_BACKOFF_MS=5000

# ── SUNAT ─────────────────────────────────────────────────────────────────────
SUNAT_BACKEND_URL=http://localhost:8000
SUNAT_BACKEND_API_KEY=
SUNAT_TOKEN=

# ── Integraciones ─────────────────────────────────────────────────────────────
UPLOADER_URL=http://localhost:8001
AI_ENGINE_URL=http://localhost:8002
AI_ENGINE_API_KEY=nm-ai-dev-key-change-in-production
INVOICING_SERVICE_URL=http://localhost:3009
INVOICING_API_KEY=nm-invoicing-dev-key-change-in-production

# ── reCAPTCHA v3 (https://www.google.com/recaptcha/admin) ─────────────────────
# Activar solo cuando tengas las claves. En false, el backend no exige token.
RECAPTCHA_ENABLED=false
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5

# ── Culqi (https://culqi.com → Desarrollo / API Keys) ─────────────────────────
# Integración (test): pk_test_ + sk_test_  |  Producción (live): pk_live_ + sk_live_
# Webhook prod: https://api.novedadesmaritex.net.pe/api/v1/ecommerce/webhooks/culqi
CULQI_ENABLED=false
CULQI_SECRET_KEY=
# CulqiPanel limita usuario/contraseña del webhook a 20 caracteres máximo.
CULQI_WEBHOOK_USER=
CULQI_WEBHOOK_PASSWORD=
# Yape + tarjeta requieren RSA (CulqiPanel → Desarrollo → RSA Keys)
# CULQI_RSA_ID=
# CULQI_RSA_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# ── WooCommerce (legacy) ──────────────────────────────────────────────────────
WOOCOMMERCE_URL=
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=
