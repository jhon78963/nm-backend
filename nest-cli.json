{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/gateway/src",
  "monorepo": true,
  "root": "apps/gateway",
  "compilerOptions": {
    "webpack": false,
    "tsConfigPath": "apps/gateway/tsconfig.app.json"
  },
  "projects": {
    "gateway": {
      "type": "application",
      "root": "apps/gateway",
      "entryFile": "main",
      "sourceRoot": "apps/gateway/src",
      "compilerOptions": {
        "tsConfigPath": "apps/gateway/tsconfig.app.json"
      }
    },
    "auth-service": {
      "type": "application",
      "root": "apps/auth-service",
      "entryFile": "main",
      "sourceRoot": "apps/auth-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/auth-service/tsconfig.app.json"
      }
    },
    "catalog-service": {
      "type": "application",
      "root": "apps/catalog-service",
      "entryFile": "main",
      "sourceRoot": "apps/catalog-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/catalog-service/tsconfig.app.json"
      }
    },
    "inventory-service": {
      "type": "application",
      "root": "apps/inventory-service",
      "entryFile": "main",
      "sourceRoot": "apps/inventory-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/inventory-service/tsconfig.app.json"
      }
    },
    "pos-service": {
      "type": "application",
      "root": "apps/pos-service",
      "entryFile": "main",
      "sourceRoot": "apps/pos-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/pos-service/tsconfig.app.json",
        "assets": [
          {
            "include": "tickets/templates/**/*",
            "outDir": "dist/apps/pos-service/apps/pos-service/src",
            "watchAssets": true
          }
        ]
      }
    },
    "finance-service": {
      "type": "application",
      "root": "apps/finance-service",
      "entryFile": "main",
      "sourceRoot": "apps/finance-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/finance-service/tsconfig.app.json"
      }
    },
    "hr-service": {
      "type": "application",
      "root": "apps/hr-service",
      "entryFile": "main",
      "sourceRoot": "apps/hr-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/hr-service/tsconfig.app.json"
      }
    },
    "report-service": {
      "type": "application",
      "root": "apps/report-service",
      "entryFile": "main",
      "sourceRoot": "apps/report-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/report-service/tsconfig.app.json"
      }
    },
    "document-service": {
      "type": "application",
      "root": "apps/document-service",
      "entryFile": "main",
      "sourceRoot": "apps/document-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/document-service/tsconfig.app.json",
        "assets": [
          {
            "include": "templates/**/*",
            "outDir": "dist/apps/document-service/apps/document-service/src",
            "watchAssets": true
          }
        ]
      }
    },
    "storage-service": {
      "type": "application",
      "root": "apps/storage-service",
      "entryFile": "main",
      "sourceRoot": "apps/storage-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/storage-service/tsconfig.app.json"
      }
    },
    "ecommerce-service": {
      "type": "application",
      "root": "apps/ecommerce-service",
      "entryFile": "main",
      "sourceRoot": "apps/ecommerce-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/ecommerce-service/tsconfig.app.json"
      }
    },
    "mail-service": {
      "type": "application",
      "root": "apps/mail-service",
      "entryFile": "main",
      "sourceRoot": "apps/mail-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/mail-service/tsconfig.app.json"
      }
    },
    "common": {
      "type": "library",
      "root": "libs/common",
      "entryFile": "index",
      "sourceRoot": "libs/common/src",
      "compilerOptions": {
        "tsConfigPath": "libs/common/tsconfig.lib.json"
      }
    },
    "database": {
      "type": "library",
      "root": "libs/database",
      "entryFile": "index",
      "sourceRoot": "libs/database/src",
      "compilerOptions": {
        "tsConfigPath": "libs/database/tsconfig.lib.json"
      }
    },
    "storage": {
      "type": "library",
      "root": "libs/storage",
      "entryFile": "index",
      "sourceRoot": "libs/storage/src",
      "compilerOptions": {
        "tsConfigPath": "libs/storage/tsconfig.lib.json"
      }
    },
    "storage-client": {
      "type": "library",
      "root": "libs/storage-client",
      "entryFile": "index",
      "sourceRoot": "libs/storage-client/src",
      "compilerOptions": {
        "tsConfigPath": "libs/storage-client/tsconfig.lib.json"
      }
    },
    "document-client": {
      "type": "library",
      "root": "libs/document-client",
      "entryFile": "index",
      "sourceRoot": "libs/document-client/src",
      "compilerOptions": {
        "tsConfigPath": "libs/document-client/tsconfig.lib.json"
      }
    },
    "mail-client": {
      "type": "library",
      "root": "libs/mail-client",
      "entryFile": "index",
      "sourceRoot": "libs/mail-client/src",
      "compilerOptions": {
        "tsConfigPath": "libs/mail-client/tsconfig.lib.json"
      }
    },
    "queue-manager": {
      "type": "library",
      "root": "libs/queue-manager",
      "entryFile": "index",
      "sourceRoot": "libs/queue-manager/src",
      "compilerOptions": {
        "tsConfigPath": "libs/queue-manager/tsconfig.lib.json"
      }
    }
  }
}
