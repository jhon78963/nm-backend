{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "esModuleInterop": true,
    "paths": {
      "@app/common": ["./libs/common/src"],
      "@app/common/*": ["./libs/common/src/*"],
      "@app/database": ["./libs/database/src"],
      "@app/database/*": ["./libs/database/src/*"],
      "@app/contracts": ["./libs/contracts/src"],
      "@app/contracts/*": ["./libs/contracts/src/*"],
      "@app/storage": ["./libs/storage/src"],
      "@app/storage/*": ["./libs/storage/src/*"],
      "@app/storage-client": ["./libs/storage-client/src"],
      "@app/storage-client/*": ["./libs/storage-client/src/*"],
      "@app/document-client": ["./libs/document-client/src"],
      "@app/document-client/*": ["./libs/document-client/src/*"],
      "@app/mail-client": ["./libs/mail-client/src"],
      "@app/mail-client/*": ["./libs/mail-client/src/*"],
      "@app/queue-manager": ["./libs/queue-manager/src"],
      "@app/queue-manager/*": ["./libs/queue-manager/src/*"],
      "@app/event-bus": ["./libs/event-bus/src"],
      "@app/event-bus/*": ["./libs/event-bus/src/*"]
    }
  }
}
