// =============================================================================
// Prisma Schema — nm-services
// Migración desde Laravel/Eloquent con PostgreSQL
// Convención: camelCase en Prisma → snake_case en DB (@map)
// Soft-delete: isDeleted + deletionTime + deletedById (replica el patrón Laravel)
// =============================================================================

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Multi-tenant ─────────────────────────────────────────────────────────────

model Tenant {
  id        String   @id @default(uuid())
  name      String   @db.VarChar(255)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("creation_time")

  warehouses Warehouse[]
  users      User[]
  roles      Role[]
  setting    TenantSetting?
  storeHeaderConfig StoreHeaderConfig?

  @@map("tenants")
}

model TenantSetting {
  id              String  @id @default(uuid())
  tenantId        String  @unique @map("tenant_id")
  ruc             String? @db.VarChar(11)
  legalName       String? @map("legal_name")
  tradeName       String? @map("trade_name")
  address         String?
  district        String?
  province        String?
  department      String?
  phone           String? @db.VarChar(20)
  email           String?
  website         String?
  socialLinks     Json?   @map("social_links")
  logoUrl         String? @map("logo_url")
  ticketFooterNote String? @map("ticket_footer_note")
  electronicInvoicingEnabled Boolean @default(false) @map("electronic_invoicing_enabled")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_settings")
}

model Warehouse {
  id                 String  @id @default(uuid())
  name               String  @db.VarChar(255)
  tenantId           String  @map("tenant_id")
  catalogPublicToken String? @unique @map("catalog_public_token")
  isDeleted          Boolean  @default(false) @map("is_deleted")
  electronicInvoicingEnabled Boolean @default(false) @map("electronic_invoicing_enabled")

  tenant Tenant  @relation(fields: [tenantId], references: [id])
  users  User[]
  products          Product[]
  vendors           Vendor[]
  customers         Customer[]
  purchases         Purchase[]
  inventoryBalances InventoryBalance[]
  inventoryMovements InventoryMovement[]
  sales             Sale[]
  cashMovements     CashMovement[]
  documentSeries    DocumentSeries[]
  accumulatedAccountSetting   AccumulatedAccountSetting?
  accumulatedAccountTransfers AccumulatedAccountTransfer[]
  teams             Team[]
  ecommerceOrders   EcommerceOrder[]

  @@map("warehouses")
}

// ─── Usuarios y RBAC ─────────────────────────────────────────────────────────

model User {
  id                 String    @id @default(uuid())
  username           String    @unique @db.VarChar(100)
  email              String    @unique @db.VarChar(255)
  passwordHash       String    @map("password_hash")
  name               String    @db.VarChar(100)
  surname            String    @db.VarChar(100)
  phone              String?   @db.VarChar(20)
  profilePicture     String?   @map("profile_picture")
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  isEnabled          Boolean   @default(true) @map("is_enabled")
  tenantId           String    @map("tenant_id")
  warehouseId        String?   @map("warehouse_id")
  isDeleted          Boolean   @default(false) @map("is_deleted")
  deletionTime       DateTime? @map("deletion_time")
  createdAt          DateTime  @default(now()) @map("creation_time")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  warehouse Warehouse? @relation(fields: [warehouseId], references: [id])

  userRoles            UserRole[]
  refreshTokens        RefreshToken[]
  actionLogs           UserActionLog[]
  passwordResets       PasswordResetToken[]
  productHistories     ProductHistory[]
  teams                Team[]
  inventoryMovementsCreated InventoryMovement[] @relation("inventoryMovementsCreated")
  ecommerceCustomer    EcommerceCustomer?

  @@map("users")
}

model Role {
  id          String  @id @default(uuid())
  name        String  @db.VarChar(100)
  guardName   String  @default("api") @map("guard_name")
  tenantId    String? @map("tenant_id")
  isSystem    Boolean @default(false) @map("is_system")

  tenant      Tenant?      @relation(fields: [tenantId], references: [id])
  userRoles   UserRole[]
  permissions RolePermission[]

  @@unique([name, tenantId])
  @@map("roles")
}

model Permission {
  id        String @id @default(uuid())
  name      String @unique @db.VarChar(255)
  guardName String @default("api") @map("guard_name")

  rolePermissions RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId String @map("user_id")
  roleId String @map("role_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ─── Tokens de autenticación ──────────────────────────────────────────────────

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  token     String   @unique
  email     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  userId    String?  @map("user_id")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

// ─── Auditoría ────────────────────────────────────────────────────────────────

model UserActionLog {
  id          String   @id @default(uuid())
  action      String   @db.VarChar(100)
  description String?
  metadata    Json?
  ipAddress   String?  @map("ip_address") @db.VarChar(45)
  userId      String   @map("user_id")
  tenantId    String?  @map("tenant_id")
  warehouseId String?  @map("warehouse_id")
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
  @@map("user_action_logs")
}

// ═══════════════════════════════════════════════════════════════════════════════
// CATÁLOGO — Products, Colors, Sizes, Genders
// ═══════════════════════════════════════════════════════════════════════════════

model Gender {
  id        String    @id @default(uuid())
  name      String    @db.VarChar(50)
  shortName String?   @map("short_name") @db.VarChar(10)
  products  Product[]

  @@map("genders")
}

model Color {
  id          String    @id @default(uuid())
  description String    @db.VarChar(100)
  hash        String?   @db.VarChar(7)
  isDeleted   Boolean   @default(false) @map("is_deleted")
  deletionTime DateTime? @map("deletion_time")

  productSizeColors   ProductSizeColor[]
  inventoryBalances   InventoryBalance[]
  inventoryMovements  InventoryMovement[]
  purchaseLineDeltas  PurchaseLineColorDelta[]

  @@map("colors")
}

model SizeType {
  id          String @id @default(uuid())
  description String @db.VarChar(100)
  sizes       Size[]

  @@map("size_types")
}

model Size {
  id          String   @id @default(uuid())
  description String   @db.VarChar(50)
  sizeTypeId  String?  @map("size_type_id")
  isDeleted   Boolean  @default(false) @map("is_deleted")

  sizeType     SizeType?     @relation(fields: [sizeTypeId], references: [id])
  productSizes ProductSize[]

  @@map("sizes")
}

model Product {
  id                 String    @id @default(uuid())
  name               String    @db.VarChar(255)
  description        String?
  shortDescription   String?   @map("short_description")
  additionalInfo     String?   @map("additional_info")
  barcode            String?   @db.VarChar(50)
  percentageDiscount String?   @map("percentage_discount") @db.VarChar(20)
  cashDiscount       Int?      @map("cash_discount")
  offerPrice         Decimal?  @map("offer_price") @db.Decimal(10, 2)
  isFeatured         Boolean   @default(false) @map("is_featured")
  isOnSale           Boolean   @default(false) @map("is_on_sale")
  isNew              Boolean   @default(false) @map("is_new")
  wooStatus          String    @default("draft") @map("woo_status")
  status             String    @default("active")
  genderId           String    @map("gender_id")
  vendorId           String?   @map("vendor_id")
  warehouseId        String    @map("warehouse_id")
  isDeleted          Boolean   @default(false) @map("is_deleted")
  deletionTime       DateTime? @map("deletion_time")
  createdById        String?   @map("created_by_id")
  updatedById        String?   @map("updated_by_id")
  deletedById        String?   @map("deleted_by_id")
  createdAt          DateTime  @default(now()) @map("creation_time")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  gender       Gender          @relation(fields: [genderId], references: [id])
  vendor       Vendor?         @relation(fields: [vendorId], references: [id])
  warehouse    Warehouse       @relation(fields: [warehouseId], references: [id])
  productSizes ProductSize[]
  histories    ProductHistory[]
  wooSyncMaps  WoocommerceSyncMap[]
  media        ProductMedia[]
  reviews      ProductReview[]

  @@index([warehouseId])
  @@index([isDeleted])
  @@map("products")
}

model ProductMedia {
  id          String   @id @default(uuid())
  productId   String   @map("product_id")
  url         String
  path        String
  mimeType    String   @map("mime_type") @db.VarChar(50)
  size        Int
  name        String   @db.VarChar(255)
  sortOrder   Int      @default(0) @map("sort_order")
  isCover     Boolean  @default(false) @map("is_cover")
  uploadedById String? @map("uploaded_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_media")
}

model ProductSize {
  id            String    @id @default(uuid())
  productId     String    @map("product_id")
  sizeId        String    @map("size_id")
  barcode       String?   @db.VarChar(50)
  purchasePrice Decimal   @map("purchase_price") @db.Decimal(10, 4)
  salePrice     Decimal   @map("sale_price") @db.Decimal(10, 2)
  minSalePrice  Decimal?  @map("min_sale_price") @db.Decimal(10, 2)
  isDeleted     Boolean   @default(false) @map("is_deleted")
  deletionTime  DateTime? @map("deletion_time")

  product           Product            @relation(fields: [productId], references: [id])
  size              Size               @relation(fields: [sizeId], references: [id])
  productSizeColors ProductSizeColor[]
  inventoryBalances InventoryBalance[]
  inventoryMovements InventoryMovement[]
  purchaseLines     PurchaseLine[]

  @@unique([productId, sizeId])
  @@map("product_size")
}

model ProductSizeColor {
  id            String @id @default(uuid())
  productSizeId String @map("product_size_id")
  colorId       String @map("color_id")

  productSize ProductSize @relation(fields: [productSizeId], references: [id], onDelete: Cascade)
  color       Color       @relation(fields: [colorId], references: [id])

  @@unique([productSizeId, colorId])
  @@map("product_size_color")
}

model ProductHistory {
  id        String   @id @default(uuid())
  productId String   @map("product_id")
  eventType String   @map("event_type") @db.VarChar(100)
  reason    String?
  oldValues Json?    @map("old_values")
  newValues Json?    @map("new_values")
  createdById String @map("created_by_id")
  createdAt DateTime @default(now()) @map("created_at")

  product   Product @relation(fields: [productId], references: [id])
  createdBy User    @relation(fields: [createdById], references: [id])

  @@index([productId])
  @@map("product_histories")
}

model WoocommerceSyncMap {
  id            String    @id @default(uuid())
  productId     String    @map("product_id")
  wooProductId  Int       @map("woo_product_id")
  checksum      String?
  lastSyncedAt  DateTime? @map("last_synced_at")

  product Product @relation(fields: [productId], references: [id])

  @@unique([productId])
  @@map("woocommerce_sync_maps")
}

// ═══════════════════════════════════════════════════════════════════════════════
// DIRECTORIO — Vendors, Customers
// ═══════════════════════════════════════════════════════════════════════════════

model Vendor {
  id          String  @id @default(uuid())
  name        String  @db.VarChar(255)
  address     String?
  local       String? @db.VarChar(100)
  phone       String? @db.VarChar(20)
  balance     Decimal @default(0) @db.Decimal(12, 2)
  warehouseId String  @map("warehouse_id")
  isDeleted   Boolean @default(false) @map("is_deleted")

  warehouse Warehouse  @relation(fields: [warehouseId], references: [id])
  products  Product[]
  purchases Purchase[]

  @@map("vendors")
}

model Customer {
  id             String  @id @default(uuid())
  documentType   String? @map("document_type") @db.VarChar(10)
  documentNumber String? @map("document_number") @db.VarChar(15)
  name           String  @db.VarChar(255)
  warehouseId    String  @map("warehouse_id")
  isDeleted      Boolean @default(false) @map("is_deleted")

  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  sales     Sale[]

  @@map("customers")
}

// ═══════════════════════════════════════════════════════════════════════════════
// INVENTARIO — Ledger (Balance + Movements) + Purchases
// ═══════════════════════════════════════════════════════════════════════════════

model InventoryBalance {
  id               String @id @default(uuid())
  warehouseId      String @map("warehouse_id")
  productSizeId    String @map("product_size_id")
  colorId          String @map("color_id")
  quantity         Int    @default(0)
  reservedQuantity Int    @default(0) @map("reserved_quantity")

  warehouse   Warehouse   @relation(fields: [warehouseId], references: [id])
  productSize ProductSize @relation(fields: [productSizeId], references: [id])
  color       Color       @relation(fields: [colorId], references: [id])

  @@unique([warehouseId, productSizeId, colorId], name: "warehouseId_productSizeId_colorId")
  @@map("inventory_balances")
}

model InventoryMovement {
  id            String   @id @default(uuid())
  warehouseId   String   @map("warehouse_id")
  productSizeId String   @map("product_size_id")
  colorId       String   @map("color_id")
  direction     String   @db.VarChar(3)   // 'IN' | 'OUT'
  quantity      Int
  movementType  String   @map("movement_type") @db.VarChar(50)
  referenceId   String?  @map("reference_id")
  referenceType String?  @map("reference_type") @db.VarChar(50)
  balanceAfter  Int      @default(0) @map("balance_after")
  occurredAt    DateTime @map("occurred_at")
  createdById   String   @map("created_by_id")

  warehouse   Warehouse   @relation(fields: [warehouseId], references: [id])
  productSize ProductSize @relation(fields: [productSizeId], references: [id])
  color       Color       @relation(fields: [colorId], references: [id])
  createdBy   User        @relation(name: "inventoryMovementsCreated", fields: [createdById], references: [id])

  @@index([warehouseId, occurredAt])
  @@index([productSizeId, colorId])
  @@map("inventory_movements")
}

model Purchase {
  id           String    @id @default(uuid())
  warehouseId  String    @map("warehouse_id")
  vendorId     String?   @map("vendor_id")
  supplierName String?   @map("supplier_name")
  currency     String    @default("PEN") @db.VarChar(3)
  exchangeRate Decimal?  @map("exchange_rate") @db.Decimal(10, 4)
  totalAmount  Decimal   @map("total_amount") @db.Decimal(12, 2)
  status       String    @default("REGISTERED") @db.VarChar(20)
  notes        String?
  purchaseDate DateTime  @map("purchase_date")
  cancelReason String?   @map("cancel_reason")
  cancelledById String?  @map("cancelled_by_id")
  cancelledAt  DateTime? @map("cancelled_at")
  isDeleted    Boolean   @default(false) @map("is_deleted")
  createdById  String    @map("created_by_id")
  createdAt    DateTime  @default(now()) @map("creation_time")

  warehouse  Warehouse      @relation(fields: [warehouseId], references: [id])
  vendor     Vendor?        @relation(fields: [vendorId], references: [id])
  lines      PurchaseLine[]

  @@index([warehouseId, purchaseDate])
  @@map("purchases")
}

model PurchaseLine {
  id              String   @id @default(uuid())
  purchaseId      String   @map("purchase_id")
  productId       String   @map("product_id")
  sizeId          String   @map("size_id")
  productSizeId   String   @map("product_size_id")
  purchasePrice   Decimal  @map("purchase_price") @db.Decimal(10, 4)
  salePrice       Decimal? @map("sale_price") @db.Decimal(10, 2)
  quantity        Int
  hasColorBreakdown Boolean @default(false) @map("has_color_breakdown")

  purchase    Purchase                 @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productSize ProductSize              @relation(fields: [productSizeId], references: [id])
  colorDeltas PurchaseLineColorDelta[]

  @@map("purchase_lines")
}

model PurchaseLineColorDelta {
  id             String @id @default(uuid())
  purchaseLineId String @map("purchase_line_id")
  colorId        String @map("color_id")
  quantity       Int

  purchaseLine PurchaseLine @relation(fields: [purchaseLineId], references: [id], onDelete: Cascade)
  color        Color        @relation(fields: [colorId], references: [id])

  @@map("purchase_line_color_deltas")
}

// ═══════════════════════════════════════════════════════════════════════════════
// POS / VENTAS — Sale, SaleDetail, SalePayment, DocumentSeries (pos-service)
// ═══════════════════════════════════════════════════════════════════════════════

model Sale {
  id                 String    @id @default(uuid())
  code               String?   @db.VarChar(50)
  warehouseId        String    @map("warehouse_id")
  customerId         String?   @map("customer_id")
  totalAmount        Decimal   @map("total_amount") @db.Decimal(12, 2)
  taxableBase        Decimal?  @map("taxable_base") @db.Decimal(12, 2)
  igv                Decimal?  @db.Decimal(12, 2)
  paymentMethod      String    @map("payment_method") @db.VarChar(20)
  status             String    @default("COMPLETED") @db.VarChar(20)
  // SUNAT / Greenter fields
  documentType       String?   @map("document_type") @db.VarChar(10)
  serie              String?   @db.VarChar(10)
  correlativo        Int?
  fullInvoiceNumber  String?   @map("full_invoice_number") @db.VarChar(20)
  sunatStatus        String?   @map("sunat_status") @db.VarChar(20)
  xmlPath            String?   @map("xml_path")
  cdrPath            String?   @map("cdr_path")
  notes              String?
  deletedById        String?   @map("deleted_by_id")
  isDeleted          Boolean   @default(false) @map("is_deleted")
  createdById        String    @map("created_by_id")
  createdAt          DateTime  @default(now()) @map("creation_time")

  warehouse             Warehouse              @relation(fields: [warehouseId], references: [id])
  customer              Customer?              @relation(fields: [customerId], references: [id])
  details               SaleDetail[]
  payments              SalePayment[]
  electronicDocumentLogs ElectronicDocumentLog[]

  @@index([warehouseId, createdAt])
  @@map("sales")
}

model SaleDetail {
  id            String  @id @default(uuid())
  saleId        String  @map("sale_id")
  productSizeId String  @map("product_size_id")
  colorId       String? @map("color_id")
  // Snapshots al momento de la venta
  productNameSnapshot String @map("product_name_snapshot")
  sizeSnapshot        String @map("size_snapshot")
  colorSnapshot       String? @map("color_snapshot")
  quantity      Int
  unitPrice     Decimal @map("unit_price") @db.Decimal(10, 2)
  subtotal      Decimal @db.Decimal(12, 2)

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@map("sale_details")
}

model SalePayment {
  id       String  @id @default(uuid())
  saleId   String  @map("sale_id")
  method   String  @db.VarChar(20)
  amount   Decimal @db.Decimal(12, 2)
  reference String? @db.VarChar(255)

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@map("sale_payments")
}

model DocumentSeries {
  id            String @id @default(uuid())
  warehouseId   String @map("warehouse_id")
  documentType  String @map("document_type") @db.VarChar(10)
  serie         String @db.VarChar(10)
  currentNumber Int    @default(1) @map("current_number")

  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  @@unique([warehouseId, documentType, serie])
  @@map("document_series")
}

model ElectronicDocumentLog {
  id           String   @id @default(uuid())
  saleId       String   @map("sale_id")
  action       String   @db.VarChar(20)
  requestPayload  Json? @map("request_payload")
  responsePayload Json? @map("response_payload")
  sunatCode    String?  @map("sunat_code") @db.VarChar(10)
  createdAt    DateTime @default(now()) @map("created_at")

  sale Sale @relation(fields: [saleId], references: [id])

  @@map("electronic_document_logs")
}

// ═══════════════════════════════════════════════════════════════════════════════
// FINANZAS — CashMovement, AccumulatedAccount (finance-service)
// ═══════════════════════════════════════════════════════════════════════════════

model CashMovement {
  id                    String    @id @default(uuid())
  warehouseId           String    @map("warehouse_id")
  type                  String    @db.VarChar(10) // 'INCOME' | 'EXPENSE'
  amount                Decimal   @db.Decimal(12, 2)
  category              String    @db.VarChar(100)
  paymentMethod         String    @map("payment_method") @db.VarChar(20)
  description           String?
  date                  DateTime
  accountingMonth       String    @map("accounting_month") @db.VarChar(7) // 'YYYY-MM'
  purchaseId            String?   @map("purchase_id")
  accumulatedBalanceApplied Boolean @default(false) @map("accumulated_balance_applied")
  isDeleted             Boolean   @default(false) @map("is_deleted")
  createdById           String    @map("created_by_id")
  createdAt             DateTime  @default(now()) @map("creation_time")

  warehouse Warehouse            @relation(fields: [warehouseId], references: [id])
  vouchers  CashMovementVoucher[]

  @@index([warehouseId, accountingMonth])
  @@map("cash_movements")
}

model CashMovementVoucher {
  id             String  @id @default(uuid())
  cashMovementId String  @map("cash_movement_id")
  voucherPath    String  @map("voucher_path")
  voucherUrl     String? @map("voucher_url")
  mimeType       String? @map("mime_type") @db.VarChar(50)
  name           String? @db.VarChar(255)
  sortOrder      Int     @default(0) @map("sort_order")

  cashMovement CashMovement @relation(fields: [cashMovementId], references: [id], onDelete: Cascade)

  @@map("cash_movement_vouchers")
}

model AccumulatedAccountSetting {
  id                  String   @id @default(uuid())
  warehouseId         String   @unique @map("warehouse_id")
  cashBalance         Decimal  @map("cash_balance") @db.Decimal(12, 2)
  digitalBalance      Decimal  @map("digital_balance") @db.Decimal(12, 2)
  trackingStartMonth  String   @map("tracking_start_month") @db.VarChar(7)
  updatedAt           DateTime @updatedAt @map("updated_at")

  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  @@map("accumulated_account_settings")
}

model AccumulatedAccountTransfer {
  id                     String   @id @default(uuid())
  warehouseId            String   @map("warehouse_id")
  transferMonth          String   @map("transfer_month") @db.VarChar(7)
  cashAmount             Decimal  @map("cash_amount") @db.Decimal(12, 2)
  digitalAmount          Decimal  @map("digital_amount") @db.Decimal(12, 2)
  closingCashAmount      Decimal  @map("closing_cash_amount") @db.Decimal(12, 2)
  closingDigitalAmount   Decimal  @map("closing_digital_amount") @db.Decimal(12, 2)
  projectedCashAmount    Decimal  @map("projected_cash_amount") @db.Decimal(12, 2)
  projectedDigitalAmount Decimal  @map("projected_digital_amount") @db.Decimal(12, 2)
  notes                  String?
  createdById            String   @map("created_by_id")
  createdAt              DateTime @default(now()) @map("created_at")

  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  @@unique([warehouseId, transferMonth])
  @@map("accumulated_account_transfers")
}

// ═══════════════════════════════════════════════════════════════════════════════
// RRHH — Teams, Attendance, Payments
// ═══════════════════════════════════════════════════════════════════════════════

model Team {
  id          String  @id @default(uuid())
  dni         String  @db.VarChar(20)
  name        String  @db.VarChar(100)
  surname     String  @db.VarChar(100)
  salary      Decimal @db.Decimal(10, 2)
  warehouseId String  @map("warehouse_id")
  userId      String? @map("user_id")
  isDeleted   Boolean @default(false) @map("is_deleted")

  warehouse   Warehouse     @relation(fields: [warehouseId], references: [id])
  user        User?         @relation(fields: [userId], references: [id])
  attendances Attendance[]
  payments    TeamPayment[]

  @@map("teams")
}

model Attendance {
  id         String   @id @default(uuid())
  teamId     String   @map("team_id")
  date       DateTime @db.Date
  status     String   @db.VarChar(20)
  checkIn    DateTime? @map("check_in")
  checkOut   DateTime? @map("check_out")
  delayMinutes Int    @default(0) @map("delay_minutes")
  notes      String?

  team Team @relation(fields: [teamId], references: [id])

  @@unique([teamId, date])
  @@map("attendances")
}

model TeamPayment {
  id              String   @id @default(uuid())
  teamId          String   @map("team_id")
  type            String   @db.VarChar(20)
  amount          Decimal  @db.Decimal(10, 2)
  date            DateTime
  payrollPeriod   String?  @map("payroll_period") @db.VarChar(7)
  accountingMonth String?  @map("accounting_month") @db.VarChar(7)
  paymentMethod   String   @map("payment_method") @db.VarChar(20)
  cashMovementId  String?  @map("cash_movement_id")

  team Team @relation(fields: [teamId], references: [id])

  @@map("team_payments")
}

// ─── Ecommerce — Storefront ────────────────────────────────────────────────────

model StoreHeaderConfig {
  id            String   @id @default(uuid())
  tenantId      String?  @unique @map("tenant_id")
  slug          String   @unique @default("default") @db.VarChar(50)
  topbarMessage String?  @map("topbar_message")
  supportPhone  String?  @map("support_phone") @db.VarChar(30)
  logoText      String   @map("logo_text") @db.VarChar(255)
  logoUrl       String?  @map("logo_url")
  topBarEnabled Boolean  @default(true) @map("top_bar_enabled")
  stickyEnabled Boolean  @default(true) @map("sticky_enabled")
  createdAt     DateTime @default(now()) @map("creation_time")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tenant          Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  navigationItems NavigationItem[]

  @@map("store_header_configs")
}

model NavigationItem {
  id             String   @id @default(uuid())
  headerConfigId String   @map("header_config_id")
  label          String   @db.VarChar(100)
  href           String   @db.VarChar(500)
  order          Int      @default(0) @map("sort_order")
  isActive       Boolean  @default(true) @map("is_active")
  parentId       String?  @map("parent_id")
  createdAt      DateTime @default(now()) @map("creation_time")
  updatedAt      DateTime @updatedAt @map("updated_at")

  headerConfig StoreHeaderConfig @relation(fields: [headerConfigId], references: [id], onDelete: Cascade)
  parent       NavigationItem?   @relation("NavigationHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children     NavigationItem[]  @relation("NavigationHierarchy")

  @@index([headerConfigId, order])
  @@map("navigation_items")
}

model StoreBanner {
  id        String   @id @default(uuid())
  slug      String   @default("default") @db.VarChar(50)
  imageUrl  String   @map("image_url") @db.VarChar(500)
  href      String   @default("/") @db.VarChar(500)
  altText   String?  @map("alt_text") @db.VarChar(200)
  order     Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("creation_time")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([slug, isActive, order])
  @@map("store_banners")
}

model StoreSection {
  id        String   @id @default(uuid())
  slug      String   @unique @db.VarChar(80)
  config    Json     @default("{}")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("creation_time")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([slug, isActive])
  @@map("store_sections")
}

model EcommerceMedia {
  id           String   @id @default(uuid())
  url          String
  path         String
  mimeType     String   @map("mime_type") @db.VarChar(100)
  size         Int
  name         String   @db.VarChar(255)
  originalName String?  @map("original_name") @db.VarChar(255)
  uploadedById String?  @map("uploaded_by_id")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([mimeType])
  @@index([createdAt])
  @@map("ecommerce_media")
}

// ═══════════════════════════════════════════════════════════════════════════════
// ECOMMERCE — Pedidos web (equivalente WooCommerce shop_order)
// ═══════════════════════════════════════════════════════════════════════════════

model EcommerceOrder {
  id                  String    @id @default(uuid())
  orderNumber         String    @unique @map("order_number") @db.VarChar(32)
  warehouseId         String    @map("warehouse_id")
  customerId          String?   @map("customer_id")
  status              String    @default("pending") @db.VarChar(30)
  paymentStatus       String    @default("pending") @map("payment_status") @db.VarChar(20)
  currency            String    @default("PEN") @db.VarChar(3)
  email               String    @db.VarChar(255)
  billingAddress      Json      @map("billing_address")
  shippingAddress     Json      @map("shipping_address")
  sameAsBilling       Boolean   @default(true) @map("same_as_billing")
  orderNotes          String?   @map("order_notes")
  shippingMethodId    String    @map("shipping_method_id") @db.VarChar(50)
  shippingMethodTitle String    @map("shipping_method_title") @db.VarChar(255)
  shippingTotal       Decimal   @map("shipping_total") @db.Decimal(12, 2)
  paymentMethodId     String    @map("payment_method_id") @db.VarChar(50)
  paymentMethodTitle  String    @map("payment_method_title") @db.VarChar(255)
  subtotal            Decimal   @db.Decimal(12, 2)
  couponCode          String?   @map("coupon_code") @db.VarChar(50)
  couponDiscount      Decimal   @default(0) @map("coupon_discount") @db.Decimal(12, 2)
  taxAmount           Decimal   @default(0) @map("tax_amount") @db.Decimal(12, 2)
  total               Decimal   @db.Decimal(12, 2)
  culqiChargeId       String?   @map("culqi_charge_id") @db.VarChar(64)
  culqiOrderId        String?   @map("culqi_order_id") @db.VarChar(64)
  stockReservedAt     DateTime? @map("stock_reserved_at")
  cancelledAt         DateTime? @map("cancelled_at")
  createdAt           DateTime  @default(now()) @map("creation_time")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  warehouse Warehouse            @relation(fields: [warehouseId], references: [id])
  customer  EcommerceCustomer?   @relation(fields: [customerId], references: [id])
  items     EcommerceOrderItem[]
  reviews   ProductReview[]
  refunds   EcommerceRefund[]
  couponRedemptions EcommerceCouponRedemption[]

  @@index([warehouseId, createdAt])
  @@index([status])
  @@index([email])
  @@index([customerId])
  @@map("ecommerce_orders")
}

model EcommerceOrderItem {
  id             String  @id @default(uuid())
  orderId        String  @map("order_id")
  productId      String  @map("product_id")
  productSizeId  String  @map("product_size_id")
  colorId        String? @map("color_id")
  nameSnapshot   String  @map("name_snapshot") @db.VarChar(255)
  variationLabel String? @map("variation_label") @db.VarChar(255)
  imageUrl       String? @map("image_url")
  quantity       Int
  unitPrice      Decimal @map("unit_price") @db.Decimal(10, 2)
  subtotal       Decimal @db.Decimal(12, 2)

  order EcommerceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("ecommerce_order_items")
}

model EcommerceCustomer {
  id           String   @id @default(uuid())
  userId       String?  @unique @map("user_id")
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash")
  name         String   @db.VarChar(255)
  isEnabled    Boolean  @default(true) @map("is_enabled")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user    User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  orders  EcommerceOrder[]
  reviews ProductReview[]
  addresses EcommerceCustomerAddress[]
  notificationSettings EcommerceCustomerNotificationSetting?
  notifications EcommerceCustomerNotification[]
  refunds EcommerceRefund[]
  newsletterSubscriptions EcommerceNewsletterSubscriber[]
  couponAssignments     EcommerceCouponAssignment[]
  couponRedemptions     EcommerceCouponRedemption[]
  cart                  EcommerceCart?
  wishlist              EcommerceWishlist?

  @@map("ecommerce_customers")
}

model EcommerceCart {
  id          String   @id @default(uuid())
  customerId  String   @unique @map("customer_id")
  warehouseId String   @map("warehouse_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  customer EcommerceCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items    EcommerceCartItem[]

  @@map("ecommerce_carts")
}

model EcommerceCartItem {
  id             String   @id @default(uuid())
  cartId         String   @map("cart_id")
  productId      String   @map("product_id")
  productSizeId  String   @map("product_size_id")
  colorId        String?  @map("color_id")
  quantity       Int
  nameSnapshot   String   @map("name_snapshot") @db.VarChar(255)
  variationLabel String?  @map("variation_label") @db.VarChar(255)
  imageUrl       String?  @map("image_url") @db.VarChar(500)
  unitPrice      Decimal  @map("unit_price") @db.Decimal(12, 2)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  cart EcommerceCart @relation(fields: [cartId], references: [id], onDelete: Cascade)

  @@unique([cartId, productSizeId, colorId])
  @@index([cartId])
  @@map("ecommerce_cart_items")
}

model EcommerceWishlist {
  id          String   @id @default(uuid())
  customerId  String   @unique @map("customer_id")
  warehouseId String   @map("warehouse_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  customer EcommerceCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items    EcommerceWishlistItem[]

  @@map("ecommerce_wishlists")
}

model EcommerceWishlistItem {
  id             String   @id @default(uuid())
  wishlistId     String   @map("wishlist_id")
  productId      String   @map("product_id")
  productSizeId  String?  @map("product_size_id")
  colorId        String?  @map("color_id")
  nameSnapshot   String   @map("name_snapshot") @db.VarChar(255)
  variationLabel String?  @map("variation_label") @db.VarChar(255)
  imageUrl       String?  @map("image_url") @db.VarChar(500)
  unitPrice      Decimal  @map("unit_price") @db.Decimal(12, 2)
  addedAt        DateTime @default(now()) @map("added_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  wishlist EcommerceWishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)

  @@unique([wishlistId, productId])
  @@index([wishlistId])
  @@map("ecommerce_wishlist_items")
}

model EcommerceCustomerAddress {
  id         String   @id @default(uuid())
  customerId String   @map("customer_id")
  label      String   @default("Principal") @db.VarChar(50)
  firstName  String   @map("first_name") @db.VarChar(100)
  lastName   String   @map("last_name") @db.VarChar(100)
  country    String   @default("PE") @db.VarChar(2)
  address1   String   @db.VarChar(255)
  address2   String?  @db.VarChar(255)
  city       String   @db.VarChar(100)
  state      String   @db.VarChar(100)
  postcode   String   @db.VarChar(20)
  phone      String?  @db.VarChar(30)
  isDefault  Boolean  @default(false) @map("is_default")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  customer EcommerceCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("ecommerce_customer_addresses")
}

model EcommerceCustomerNotificationSetting {
  id           String   @id @default(uuid())
  customerId   String   @unique @map("customer_id")
  orderUpdates Boolean  @default(true) @map("order_updates")
  promotions   Boolean  @default(false)
  newsletter   Boolean  @default(false)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  customer EcommerceCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("ecommerce_customer_notification_settings")
}

model EcommerceCustomerNotification {
  id         String    @id @default(uuid())
  customerId String    @map("customer_id")
  type       String    @db.VarChar(50)
  title      String    @db.VarChar(255)
  message    String    @db.Text
  readAt     DateTime? @map("read_at")
  metadata   Json?
  createdAt  DateTime  @default(now()) @map("created_at")

  customer EcommerceCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, createdAt])
  @@map("ecommerce_customer_notifications")
}

model EcommerceRefund {
  id         String   @id @default(uuid())
  orderId    String   @map("order_id")
  customerId String   @map("customer_id")
  status     String   @default("pending") @db.VarChar(30)
  reason     String   @db.Text
  amount     Decimal? @db.Decimal(12, 2)
  adminNotes String?  @map("admin_notes") @db.Text
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  order    EcommerceOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customer EcommerceCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, createdAt])
  @@index([orderId])
  @@map("ecommerce_refunds")
}

model ProductReview {
  id              String    @id @default(uuid())
  productId       String    @map("product_id")
  customerId      String    @map("customer_id")
  orderId         String    @map("order_id")
  rating          Int
  description     String
  status          String    @default("pending") @db.VarChar(20)
  rejectionReason String?   @map("rejection_reason")
  moderatedById   String?   @map("moderated_by_id")
  moderatedAt     DateTime? @map("moderated_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  product  Product           @relation(fields: [productId], references: [id])
  customer EcommerceCustomer @relation(fields: [customerId], references: [id])
  order    EcommerceOrder    @relation(fields: [orderId], references: [id])

  @@unique([productId, customerId])
  @@index([productId, status])
  @@index([status, createdAt])
  @@map("product_reviews")
}

model EcommerceNewsletterSubscriber {
  id             String    @id @default(uuid())
  email          String    @unique @db.VarChar(255)
  status         String    @default("active") @db.VarChar(20)
  source         String    @default("footer") @db.VarChar(50)
  customerId     String?   @map("customer_id")
  subscribedAt   DateTime  @default(now()) @map("subscribed_at")
  unsubscribedAt DateTime? @map("unsubscribed_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  customer EcommerceCustomer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([subscribedAt])
  @@map("ecommerce_newsletter_subscribers")
}

model EcommerceNewsletterCampaign {
  id          String    @id @default(uuid())
  subject     String    @db.VarChar(255)
  title       String    @db.VarChar(255)
  body        String    @db.Text
  previewText String?   @map("preview_text") @db.VarChar(255)
  ctaUrl      String?   @map("cta_url") @db.VarChar(500)
  ctaLabel    String?   @map("cta_label") @db.VarChar(100)
  status      String    @default("sent") @db.VarChar(20)
  sentCount   Int       @default(0) @map("sent_count")
  failedCount Int       @default(0) @map("failed_count")
  sentAt      DateTime? @map("sent_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@map("ecommerce_newsletter_campaigns")
}

model EcommerceCoupon {
  id               String    @id @default(uuid())
  code             String    @unique @db.VarChar(50)
  description      String?   @db.VarChar(255)
  discountType     String    @map("discount_type") @db.VarChar(20)
  discountValue    Decimal   @map("discount_value") @db.Decimal(12, 2)
  minSubtotal      Decimal   @default(0) @map("min_subtotal") @db.Decimal(12, 2)
  maxDiscount      Decimal?  @map("max_discount") @db.Decimal(12, 2)
  usageLimit       Int?      @map("usage_limit")
  usageCount       Int       @default(0) @map("usage_count")
  perCustomerLimit Int       @default(1) @map("per_customer_limit")
  perIpLimit       Int       @default(0) @map("per_ip_limit")
  isWelcome        Boolean   @default(false) @map("is_welcome")
  isActive         Boolean   @default(true) @map("is_active")
  startsAt         DateTime? @map("starts_at")
  expiresAt        DateTime? @map("expires_at")
  warehouseId      String?   @map("warehouse_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  assignments EcommerceCouponAssignment[]
  redemptions EcommerceCouponRedemption[]

  @@index([isActive, isWelcome])
  @@map("ecommerce_coupons")
}

model EcommerceCouponAssignment {
  id         String    @id @default(uuid())
  couponId   String    @map("coupon_id")
  customerId String    @map("customer_id")
  assignedAt DateTime  @default(now()) @map("assigned_at")
  usedAt     DateTime? @map("used_at")

  coupon   EcommerceCoupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  customer EcommerceCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([couponId, customerId])
  @@index([customerId])
  @@map("ecommerce_coupon_assignments")
}

model EcommerceCouponRedemption {
  id             String   @id @default(uuid())
  couponId       String   @map("coupon_id")
  orderId        String?  @map("order_id")
  customerId     String?  @map("customer_id")
  clientIp       String?  @map("client_ip") @db.VarChar(45)
  discountAmount Decimal  @map("discount_amount") @db.Decimal(12, 2)
  redeemedAt     DateTime @default(now()) @map("redeemed_at")

  coupon   EcommerceCoupon    @relation(fields: [couponId], references: [id], onDelete: Cascade)
  order    EcommerceOrder?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  customer EcommerceCustomer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([couponId, redeemedAt])
  @@index([couponId, clientIp])
  @@index([customerId])
  @@index([orderId])
  @@map("ecommerce_coupon_redemptions")
}

// ═══════════════════════════════════════════════════════════════════════════════
// CHATBOT — Conversaciones, Mensajes, Agentes, Leads
// ═══════════════════════════════════════════════════════════════════════════════

model ChatConversation {
  id                  String    @id @default(uuid())
  userId              String    @map("user_id")
  phoneNumber         String    @map("phone_number")
  status              String    @default("active")
  mode                String    @default("bot")
  handoffState        String    @default("none") @map("handoff_state")
  consecutiveHandoffs Int       @default(0) @map("consecutive_handoffs")
  assignedAgentId     String?   @map("assigned_agent_id")
  handoffAt           DateTime? @map("handoff_at")
  handoffBy           String?   @map("handoff_by")
  lastUserMessageAt   DateTime? @map("last_user_message_at")
  lastAgentMessageAt  DateTime? @map("last_agent_message_at")
  unreadCountAgent    Int       @default(0) @map("unread_count_agent")
  currentProgramName  String?   @map("current_program_name")
  labels              String[]  @default([])
  pinned              Boolean   @default(false)
  archivedAt          DateTime? @map("archived_at")
  metaData            Json?     @map("meta_data")
  systemPrompt        String?   @map("system_prompt")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  messages ChatMessage[]
  agent    ChatAgent?    @relation(fields: [assignedAgentId], references: [id])

  @@index([phoneNumber, status])
  @@index([assignedAgentId, mode, status])
  @@index([lastUserMessageAt])
  @@map("chat_conversations")
}

model ChatMessage {
  id             String    @id @default(uuid())
  conversationId String    @map("conversation_id")
  externalId     String?   @unique @map("external_id")
  role           String
  content        String
  contentType    String    @default("text") @map("content_type")
  mediaUrl       String?   @map("media_url")
  mimeType       String?   @map("mime_type")
  fileName       String?   @map("file_name")
  caption        String?
  status         String    @default("received")
  timestamp      DateTime  @default(now())
  deliveredAt    DateTime? @map("delivered_at")
  readAt         DateTime? @map("read_at")
  metadata       Json?

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, timestamp])
  @@map("chat_messages")
}

model ChatAgent {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  name         String
  email        String    @unique
  whatsapp     String
  status       String    @default("Active")
  username     String?   @unique
  passwordHash String?   @map("password_hash")
  role         String    @default("agent")
  lastLoginAt  DateTime? @map("last_login_at")
  calendarLink String?   @map("calendar_link")
  picture      String?
  description  String?
  location     String?
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  conversations ChatConversation[]

  @@index([status])
  @@map("chat_agents")
}

model ChatQuickReply {
  id        String   @id @default(uuid())
  title     String
  body      String
  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([title])
  @@map("chat_quick_replies")
}

model ChatFunnelUser {
  id              String   @id @default(uuid())
  senderId        String   @unique @map("sender_id")
  name            String?
  platform        String   @default("whatsapp")
  showTerms       Boolean  @default(false) @map("show_terms")
  stage           String   @default("AWARENESS")
  userCategory    String   @default("first_contact") @map("user_category")
  campaignId      String?  @map("campaign_id")
  adId            String?  @map("ad_id")
  utmSource       String?  @map("utm_source")
  currentFunnelId String?  @map("current_funnel_id")
  assignedAgent   String?  @map("assigned_agent")
  session         Json     @default("{}")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([senderId])
  @@index([stage])
  @@map("chat_funnel_users")
}

model ChatLead {
  id              String   @id @default(uuid())
  documentType    String   @map("document_type")
  document        String
  name            String
  motherLastName  String?  @map("mother_last_name")
  fatherLastName  String?  @map("father_last_name")
  whatsapp        String
  email           String
  productInterest String?  @map("product_interest")
  source          String   @default("whatsapp")
  platform        String   @default("whatsapp")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([whatsapp])
  @@index([email])
  @@map("chat_leads")
}

model ChatContextData {
  id              String   @id @default(uuid())
  originalId      String   @unique @map("original_id")
  fullTextContent String   @map("full_text_content")
  productName     String   @map("product_name")
  updatedAt       DateTime @default(now()) @map("updated_at")

  @@index([productName])
  @@map("chat_context_data")
}

model ChatTokenBlacklist {
  id        String   @id @default(uuid())
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([expiresAt])
  @@map("chat_token_blacklist")
}
