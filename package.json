{
  "name": "nm-services",
  "version": "1.0.0",
  "description": "Novedades Maritex — Microservicios NestJS (migrado desde Laravel 12)",
  "private": true,
  "scripts": {
    "build:auth": "nest build auth-service",
    "build:catalog": "nest build catalog-service",
    "build:inventory": "nest build inventory-service",
    "build:pos": "nest build pos-service",
    "build:finance": "nest build finance-service",
    "build:hr": "nest build hr-service",
    "build:ecommerce": "nest build ecommerce-service",
    "build:mail": "nest build mail-service",
    "build:gateway": "nest build gateway",
    "start:auth": "node dist/apps/auth-service/main",
    "start:dev:auth": "nest start auth-service --watch",
    "start:dev:catalog": "nest start catalog-service --watch",
    "start:dev:inventory": "nest start inventory-service --watch",
    "start:dev:pos": "nest start pos-service --watch",
    "start:dev:finance": "nest start finance-service --watch",
    "start:dev:hr": "nest start hr-service --watch",
    "start:dev:ecommerce": "nest start ecommerce-service --watch",
    "start:dev:mail": "nest start mail-service --watch",
    "start:dev:report": "nest start report-service --watch",
    "start:dev:document": "nest start document-service --watch",
    "start:dev:gateway": "nest start gateway --watch",
    "test": "jest",
    "test:auth": "jest apps/auth-service --passWithNoTests --forceExit",
    "test:catalog": "jest apps/catalog-service --passWithNoTests --forceExit",
    "test:inventory": "jest apps/inventory-service --passWithNoTests --forceExit",
    "test:pos": "jest apps/pos-service --passWithNoTests --forceExit",
    "test:finance": "jest apps/finance-service --passWithNoTests --forceExit",
    "test:hr": "jest apps/hr-service --passWithNoTests --forceExit",
    "test:gateway": "jest apps/gateway --passWithNoTests --forceExit",
    "test:mail": "jest apps/mail-service --passWithNoTests --forceExit",
    "test:all": "jest --passWithNoTests --forceExit",
    "test:cov": "jest --coverage --forceExit",
    "test:e2e": "jest --config jest-e2e.config.js --forceExit",
    "db:migrate": "prisma migrate dev --schema=libs/database/prisma/schema.prisma",
    "db:migrate:prod": "prisma migrate deploy --schema=libs/database/prisma/schema.prisma",
    "db:push": "prisma db push --schema=libs/database/prisma/schema.prisma",
    "db:generate": "prisma generate --schema=libs/database/prisma/schema.prisma",
    "db:studio": "prisma studio --schema=libs/database/prisma/schema.prisma",
    "db:seed": "ts-node libs/database/prisma/seed.ts",
    "db:seed:dev-admin": "ts-node libs/database/prisma/seed.ts",
    "seed:chatbot": "ts-node libs/database/prisma/seeds/chatbot-seed.ts",
    "db:migrate:etl": "ts-node --project tsconfig.migration.json scripts/migrate-laravel-data.ts",
    "db:migrate:action-logs": "ts-node --project tsconfig.migration.json scripts/migrate-action-logs.ts",
    "db:migrate:permissions": "ts-node --project tsconfig.migration.json scripts/migrate-permissions.ts",
    "docker:up": "./start-dev.sh --full",
    "docker:down": "./scripts/start-docker-env.sh --down",
    "docker:logs": "docker compose -f docker-compose.full.yml logs -f",
    "docker:rebuild:reviews": "./scripts/rebuild-reviews-stack.sh",
    "db:restore:nm-db": "./scripts/restore-nm-db-backup.sh",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "format": "prettier --write \"**/*.ts\"",
    "skills:install": "skills experimental_install",
    "skills:update": "skills update -p -y"
  },
  "dependencies": {
    "@fastify/helmet": "^11.1.1",
    "@fastify/multipart": "^7.7.3",
    "@fastify/static": "^7.0.4",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^10.4.0",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/microservices": "^10.4.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-fastify": "^10.4.0",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^7.4.0",
    "@nestjs/throttler": "^6.2.1",
    "@prisma/client": "^5.22.0",
    "@types/nodemailer": "^8.0.1",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.3.4",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dayjs": "^1.11.13",
    "decimal.js": "^10.6.0",
    "exceljs": "^4.4.0",
    "handlebars": "^4.7.9",
    "helmet": "^8.0.0",
    "ioredis": "^5.11.1",
    "nodemailer": "^9.1.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdfkit": "^0.20.1",
    "prisma": "^5.22.0",
    "puppeteer": "^24.43.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.3.0",
    "@nestjs/cli": "^10.4.0",
    "@nestjs/schematics": "^10.2.0",
    "@nestjs/testing": "^10.4.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.9.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.14.0",
    "@typescript-eslint/parser": "^8.14.0",
    "eslint": "^9.14.0",
    "jest": "^29.7.0",
    "jest-mock-extended": "^3.0.7",
    "pg": "^8.23.0",
    "prettier": "^3.3.3",
    "skills": "^1.5.23",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s",
      "!**/node_modules/**",
      "!**/dist/**"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/apps/",
      "<rootDir>/libs/"
    ],
    "moduleNameMapper": {
      "^@app/common(|/.*)$": "<rootDir>/libs/common/src/$1",
      "^@app/database(|/.*)$": "<rootDir>/libs/database/src/$1",
      "^@app/contracts(|/.*)$": "<rootDir>/libs/contracts/src/$1",
      "^@app/document-client(|/.*)$": "<rootDir>/libs/document-client/src/$1",
      "^@app/mail-client(|/.*)$": "<rootDir>/libs/mail-client/src/$1",
      "^@app/queue-manager(|/.*)$": "<rootDir>/libs/queue-manager/src/$1"
    }
  },
  "prisma": {
    "seed": "ts-node libs/database/prisma/seed.ts"
  }
}
