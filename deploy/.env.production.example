# =============================================================================
# nm-backend — plantilla .env PRODUCCIÓN (cutover nm-frontend-v2)
#
# Uso en servidor:
#   1. Copia a .env:  cp deploy/.env.production.example .env
#   2. Rellena secretos (APP_KEY, DB_*, SUNAT_*, UPLOADER_*, etc.)
#   3. Ajusta dominios si difieren de novedadesmaritex.net.pe
#   4. php artisan config:check-security
#   5. php artisan config:cache && php artisan route:cache
#
# Guía completa: docs/DEPLOY-SECURITY.md
# Cutover frontend: ../nm-frontend-v2/cutover/04-backend-env.md
# =============================================================================

APP_NAME="Novedades Maritex"
APP_ENV=production
APP_KEY=base64:GENERAR_CON_php_artisan_key_generate
APP_DEBUG=false
APP_TIMEZONE=America/Lima
APP_URL=https://api.novedadesmaritex.net.pe

# URL pública del SPA v2 (reset password, emails de bienvenida)
FRONTEND_URL=https://adm.novedadesmaritex.net.pe

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_PE

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# --- Cookies Sanctum / sesión (SPA adm.* + API api.*) ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_PATH=/
SESSION_DOMAIN=.novedadesmaritex.net.pe
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=none

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# --- CORS + Sanctum (obligatorio para v2 con cookies cross-subdomain) ---
# Orígenes sin barra final. Añade staging si aplica: https://staging.adm....
CORS_ALLOWED_ORIGINS=https://adm.novedadesmaritex.net.pe

# Hostnames sin https://, separados por coma (sin espacios)
SANCTUM_STATEFUL_DOMAINS=adm.novedadesmaritex.net.pe,localhost,localhost:4200,127.0.0.1,127.0.0.1:4200

# --- Servicios externos ---
UPLOADER_URL=https://upload.novedadesmaritex.net.pe
UPLOADER_PUBLIC_URL=https://upload.novedadesmaritex.net.pe
UPLOADER_API_KEY=

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@novedadesmaritex.net.pe
MAIL_FROM_NAME="${APP_NAME}"

# WooCommerce, SUNAT, etc. — completar según entorno real
WOO_SYNC_ENABLED=false
SUNAT_MODE=produccion
