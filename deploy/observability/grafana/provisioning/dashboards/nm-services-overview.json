{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["nm-services", "observability"],
  "templating": {
    "list": [
      {
        "name": "service",
        "type": "query",
        "datasource": { "type": "loki", "uid": "loki" },
        "query": "label_values({app=\"nm-services\"}, service)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": { "selected": true, "text": "All", "value": "$__all" }
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "NM Services — Overview",
  "uid": "nm-services-overview",
  "version": 1,
  "panels": [
    {
      "type": "text",
      "title": "",
      "gridPos": { "h": 3, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "options": {
        "mode": "markdown",
        "content": "# NM Services — Dashboard operacional\nLogs centralizados de **todos los microservicios** (gateway, auth, POS, ecommerce, report, chatbot, etc.) vía Loki + Promtail. Filtra por servicio arriba."
      }
    },
    {
      "type": "stat",
      "title": "Errores (24 h)",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 3 },
      "id": 1,
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "expr": "sum(count_over_time({app=\"nm-services\", service=~\"$service\"} | json | level=\"error\" [24h]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "color": { "mode": "fixed", "fixedColor": "red" } },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Proxy fallidos gateway (1 h)",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 3 },
      "id": 2,
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "expr": "sum(count_over_time({app=\"nm-services\", service=\"gateway\"} | json | event=\"gateway.proxy.failed\" [1h]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "color": { "mode": "fixed", "fixedColor": "orange" } },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "HTTP 5xx gateway (1 h)",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 3 },
      "id": 3,
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "expr": "sum(count_over_time({app=\"nm-services\", service=\"gateway\"} | json | event=\"http.request.completed\" | statusCode >= 500 [1h]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "color": { "mode": "fixed", "fixedColor": "red" } },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Requests gateway (1 h)",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 3 },
      "id": 4,
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "expr": "sum(count_over_time({app=\"nm-services\", service=\"gateway\"} | json | event=\"http.request.completed\" [1h]))",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Volumen de logs por servicio",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 7 },
      "id": 5,
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "expr": "sum by (service) (count_over_time({app=\"nm-services\", service=~\"$service\"} | json [5m]))",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 20 } }, "overrides": [] }
    },
    {
      "type": "logs",
      "title": "Errores recientes",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 15 },
      "id": 6,
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "expr": "{app=\"nm-services\", service=~\"$service\"} | json | level=\"error\"",
          "refId": "A"
        }
      ],
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": true,
        "showCommonLabels": false,
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      }
    },
    {
      "type": "logs",
      "title": "Gateway — proxy y HTTP estructurado",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 27 },
      "id": 7,
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "expr": "{app=\"nm-services\", service=\"gateway\"} | json | event=~\"gateway.proxy.*|http.request.*\"",
          "refId": "A"
        }
      ],
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": true,
        "showCommonLabels": false,
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      }
    }
  ]
}
